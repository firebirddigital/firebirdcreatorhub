# Copy to .env.local for local dev, and add the same values in Vercel → Project → Settings → Environment Variables.
# Leave AIRTABLE_* blank to run on sample data.

# Airtable personal access token (scopes: data.records:read, data.records:write) with access to the base
AIRTABLE_TOKEN=
# Base ID, starts with "app"
AIRTABLE_BASE_ID=

# Apify API token (Apify Console → Settings → Integrations)
APIFY_TOKEN=
# Optional: swap the scraper actors without touching code
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper

# Team login. Leave TEAM_PASSWORD blank to turn the login off (local dev only).
TEAM_PASSWORD=
# Any long random string. Signs login cookies and campaign share links.
# Changing it signs everyone out and revokes every share link.
AUTH_SECRET=

# Vercel sends this automatically to the daily cron job. Any long random string.
CRON_SECRET=

# Draft videos (private). Vercel adds BLOB_READ_WRITE_TOKEN for the older public store; draft uploads and
# Spotify streams use a separate private store. Copy its read-write token here (Vercel → Storage → the
# private store → .env.local tab).
BLOB_PRIVATE_READ_WRITE_TOKEN=

# Email notifications (optional). Nothing sends until RESEND_API_KEY and NOTIFY_FROM are set.
# NOTIFY_FROM must be on a domain verified in Resend, e.g. "Firebird Creator Hub <hub@firebird-music.com>".
RESEND_API_KEY=
NOTIFY_FROM=
# Comma-separated team addresses that get every update (drafts in, partner decisions).
TEAM_NOTIFY_EMAILS=

# Request status write-back (optional): webhook URLs from the two Airtable automations in the operations
# base ("When webhook received" → "Update record"). Nothing is sent until these are set.
REQUEST_WEBHOOK_INFLUENCER=
REQUEST_WEBHOOK_SEEDING=

# Nightly creator stats refresh (optional tuning). Each creator costs Apify credit; the job also skips any night
# when Apify spend is past 80% of the monthly limit, so campaign post stats keep their budget.
CREATOR_REFRESH_PER_NIGHT=20
CREATOR_REFRESH_MIN_AGE_DAYS=14
