# Copy to .env.local for local dev, and add the same values in Vercel → Project → Settings → Environment Variables.
# Leave AIRTABLE_* blank to run on sample data.

# Airtable personal access token (scopes: data.records:read, data.records:write) with access to the base
AIRTABLE_TOKEN=
# Base ID, starts with "app"
AIRTABLE_BASE_ID=

# Apify API token (Apify Console → Settings → Integrations)
APIFY_TOKEN=
# Optional: swap the scraper actors without touching code
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper

# Team login. Leave TEAM_PASSWORD blank to turn the login off (local dev only).
TEAM_PASSWORD=
# Any long random string. Signs login cookies and campaign share links.
# Changing it signs everyone out and revokes every share link.
AUTH_SECRET=

# Vercel sends this automatically to the daily cron job. Any long random string.
CRON_SECRET=
